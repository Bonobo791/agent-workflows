# Copy privately. Use absolute paths; never put credential values in this file.
PYTHONPATH=/replace/with/absolute/agent-workflows/checkout
WORKFLOW_DATA_DIR=/replace/with/private/worker/state
WORKFLOW_CONTROL_DIR=/replace/with/private/worker/state
CONTROL_SECRET_FILE=/replace/with/private/control-secret
WORKFLOW_EXECUTION_MODE=local
LOCAL_RUNTIME_CONFIG_FILE=/replace/with/private/local-runtime.json
WORKFLOW_LIFECYCLE_MODE=manual
MANUAL_WORKER_TARGET=replace-with-exact-worker-target
MANUAL_WORKER_INCARNATION=replace-with-distinct-incarnation
