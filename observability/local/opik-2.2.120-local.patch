--- a/deployment/docker-compose/nginx_default_local.conf
+++ b/deployment/docker-compose/nginx_default_local.conf
@@ -4,8 +4,8 @@ large_client_header_buffers 4 64k;
 
 # Resolver allows nginx to re-resolve DNS periodically (every 30s)
 # This allows nginx to start even if backend service is not yet available
-# Docker's internal DNS resolver is typically at 127.0.0.11
-resolver 127.0.0.11 valid=30s;
+# NGINX_LOCAL_RESOLVERS is set by the image from /etc/resolv.conf (Docker: 127.0.0.11; Podman: the network DNS)
+resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
 resolver_timeout 2s;
 
