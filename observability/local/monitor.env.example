# Copy privately to ~/.config/agent-workflows/monitor.env and replace every path.
# Values are paths and ports only; store credential values in separate private files.
PYTHONPATH=/replace/with/absolute/agent-workflows/checkout
WORKFLOW_DATA_DIR=/replace/with/private/worker/data
CONTROL_SECRET_FILE=/replace/with/private/control-secret
WORKFLOW_METRICS_HTTP_SECRET_FILE=/replace/with/private/scrape-token
WORKFLOW_METRICS_HTTP_PORT=19190
WORKFLOW_ALERT_SECRET_FILE=/replace/with/private/alert-token
WORKFLOW_ALERT_PORT=19192
