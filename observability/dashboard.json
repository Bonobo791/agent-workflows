{
  "title": "Agent workflows - private operational state",
  "uid": "agent-workflows-state",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "tags": ["agent-workflows"],
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "label": "Prometheus"}]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Jobs by state", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "sum by (status) (workflow_jobs)", "legendFormat": "{{status}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "Awaiting approval or review", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "sum by (workflow, status) (workflow_stages{status=~\"awaiting_approval|awaiting_review\"})", "legendFormat": "{{workflow}} {{status}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Expired leases and quota pauses", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "workflow_expired_leases", "legendFormat": "expired lease", "refId": "A"}, {"expr": "sum by (workflow) (workflow_quota_pauses)", "legendFormat": "quota {{workflow}}", "refId": "B"}]},
    {"id": 4, "type": "timeseries", "title": "Inputs with retries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "sum by (workflow, stage) (workflow_retried_inputs)", "legendFormat": "{{workflow}} {{stage}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Recorded cache reuse", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "sum by (workflow, stage) (workflow_cache_reuses)", "legendFormat": "{{workflow}} {{stage}}", "refId": "A"}]},
    {"id": 7, "type": "timeseries", "title": "Latest recorded launch observations", "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "sum by (workflow, role, status) (workflow_launch_observations{status=~\"requested|uncertain\"})", "legendFormat": "{{workflow}} {{role}} {{status}}", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "Observed tool events", "gridPos": {"x": 0, "y": 32, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "sum by (workflow, role, tool, status) (workflow_observed_tools)", "legendFormat": "{{workflow}} {{role}} {{tool}} {{status}}", "refId": "A"}]},
    {"id": 5, "type": "text", "title": "Evidence gaps", "gridPos": {"x": 0, "y": 40, "w": 24, "h": 14}, "options": {"mode": "markdown", "content": "These panels show private database snapshots, not live process proof. Launch observations are historical and may remain uncertain after separate recovery; they do not establish whether a worker is running. Tool observations include only received events, not proof of complete activity or successful commands. Cache reuse counts begin when instrumentation is installed and may decrease after retention or database restoration; they are not an efficiency ratio. Context efficiency, tool timings and telemetry delivery gaps are unavailable. Missing series do not mean zero. Confirm stopped workers and investigate state in the private control plane."}}
  ]
}
