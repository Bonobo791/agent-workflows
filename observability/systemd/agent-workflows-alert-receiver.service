[Unit]
Description=Agent Workflows local desktop alert receiver
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/agent-workflows/monitor.env
ExecStart=/usr/bin/python3 -m runner.desktop_alert_receiver
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
