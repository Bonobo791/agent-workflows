{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketing stage result (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "status",
    "input_versions",
    "outputs",
    "findings"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "blocked",
        "failed",
        "awaiting_review"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "input_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "not": {
                "properties": {
                  "severity": {
                    "const": "blocking"
                  },
                  "resolution": {
                    "const": "open"
                  }
                },
                "required": [
                  "severity",
                  "resolution"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "description",
        "evidence",
        "remedy",
        "resolution",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "blocking",
            "nonblocking"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "remedy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resolution": {
          "enum": [
            "open",
            "resolved",
            "invalid",
            "out_of_scope"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
